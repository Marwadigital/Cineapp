# ==============================================================================
# CineBook Environment Configuration
# ==============================================================================

# Neon Serverless PostgreSQL Database URLs (from Vercel Marketplace)
# Pooled connection string used by application queries:
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-pool-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct / Unpooled connection string used for Drizzle migrations:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your_password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign and verify JWT authentication cookies (at least 32 chars)
AUTH_SECRET="cinebook_super_secret_auth_token_key_change_in_production_32chars"

# Secret required to trigger the seat hold cleanup endpoint /api/cron/release-holds
CRON_SECRET="cinebook_cron_secret_token_987654321"

# Payment Provider Test Secret (Stripe Test Mode)
STRIPE_SECRET_KEY="sk_test_mock_cinebook_stripe_key_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_mock_cinebook_webhook_secret"

# Vercel Blob Storage Token (Optional - falls back to CDN images)
BLOB_READ_WRITE_TOKEN=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
